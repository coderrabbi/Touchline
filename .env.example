# Copy API variables to apps/api/.env. Never commit the populated file.
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon: use the pooled URL above and the direct URL below for migrations.
# Copy both URLs from Neon; keep their SSL parameters. Leave blank for local PostgreSQL.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_48_RANDOM_CHARACTERS
FRONTEND_URL=http://localhost:3100
BACKEND_URL=http://localhost:4100
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Touchline <noreply@example.com>
EMAIL_MODE=development
DEV_INBOX_DIR=../../.local/mail
SEED_ADMIN_PASSWORD=
# Object-storage adapter configuration reserved for the uploads phase.
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Copy these public/server frontend settings to apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
API_INTERNAL_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100
