{
  "name": "@touchline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
 "scripts": {
  "dev": "tsx watch src/local-server.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/local-server.js",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "test": "vitest run",
  "db:generate": "prisma generate",
  "db:migrate": "prisma migrate deploy",
  "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-competition.ts",
  "db:studio": "prisma studio"
},
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@touchline/shared": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^4.0.14"
  }
}
