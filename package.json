{
  "name": "touchline",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @touchline/api\" \"npm run dev -w @touchline/web\"",
    "build": "npm run build -w @touchline/shared && npm run build -w @touchline/api && npm run build -w @touchline/web",
    "typecheck": "npm run build -w @touchline/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "npm run test -w @touchline/api",
    "db:generate": "npm run db:generate -w @touchline/api",
    "db:migrate": "npm run db:migrate -w @touchline/api",
    "db:seed": "npm run db:seed -w @touchline/api",
    "db:studio": "npm run db:studio -w @touchline/api",
    "email:check": "npm exec -w @touchline/api -- node check-email.mjs",
    "launch:check": "npm exec -w @touchline/api -- node check-launch.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "local:db:start": "node scripts/local-db.mjs start",
    "local:db:stop": "node scripts/local-db.mjs stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "deepmerge-ts": "8.0.2",
    "eslint": "^9.39.0",
    "mysql2": "3.24.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}

